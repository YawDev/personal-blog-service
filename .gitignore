# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet
*.nupkg
*.snupkg

# MSBuild
*.binlog

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
CodeCoverage/

# Temp / backup files
~$*
*~

# Visual Studio — entire .vs folder (IDE state, indices, caches)
.vs/

# Visual Studio — file content index / search index files
*.vsidx

# Visual Studio — user-specific project settings
*.csproj.user
*.vbproj.user
*.fsproj.user

# VS Code
.vscode/launch.json
.vscode/tasks.json

# Sensitive / environment-specific config
**/appsettings.Development.json
**/appsettings.Local.json
**/Properties/launchSettings.json
